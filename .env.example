# The root app reads Streamlit secrets first, then process environment.
# This file is documentation; Streamlit does NOT automatically load .env.
# Docker Compose reads .env through env_file. Never commit real secrets.

# Required for a hosted deployment: refuse UI access if APP_PASSWORD is absent.
# Local default when unset: false. This does not choose a storage backend.
CLOUD_DEPLOYMENT=true

# Shared team gate for the existing internal dashboard. Not individual SaaS auth.
# Set a real long random value privately. Never use this placeholder in production.
APP_PASSWORD=replace-with-a-long-random-password

# Optional: unset/empty selects local SQLite and filesystem storage.
# Hosted durable storage: PostgreSQL URL; connections require SSL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional: local data folder; default is vendor_data beside root app.py.
# PostgreSQL mode stores document bytes in the database instead.
# VENDOR_DATA_DIR=C:/path/to/isolated/vendor_data

# No worker, object-store, billing or OIDC variables are consumed by this scaffold.
# Port/address use Streamlit CLI flags or .streamlit/config.toml, not custom vars.
