# Copy this file to .env and fill in what you need. Every setting below also has a sensible
# default, so an empty .env (or none at all) still runs the demo. Values here are read once at
# startup; day-to-day options (thresholds, matching toggles, which folder to read) are edited in
# the dashboard instead and are stored in data/runtime_config.json.

# ---------------------------------------------------------------------------
# Paths (defaults are all relative to the project folder; leave blank to use them)
# ---------------------------------------------------------------------------
DATA_DIR=
OUTPUT_DIR=
LOG_DIR=
DB_PATH=
SECRETS_DIR=

# ---------------------------------------------------------------------------
# Input source - pick ONE. Both can also be set from the dashboard's "Source" page.
# ---------------------------------------------------------------------------
# A folder on this machine (sub-folders are included). Read-only - files are never modified.
LOCAL_INPUT_DIR=

# A Google Drive folder (read-only `drive.readonly` scope). Paste the folder's share link.
GOOGLE_DRIVE_FOLDER_URL=
GOOGLE_DRIVE_FOLDER_ID=
# Auth option A - OAuth (interactive, once): put your Google Cloud "Desktop app" OAuth client
# JSON at the path below, then run:  python -m app drive-auth
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=secrets/client_secret.json
GOOGLE_TOKEN_FILE=secrets/token.json
# Auth option B - a service account (no interactive step): share the Drive folder with the
# service account's e-mail address and point this at its downloaded JSON key.
GOOGLE_SERVICE_ACCOUNT_FILE=

# ---------------------------------------------------------------------------
# OCR (scanned PDFs and images) - needs the `tesseract-ocr` system package
# ---------------------------------------------------------------------------
OCR_ENABLED=true
OCR_LANG=eng
OCR_DPI=250
TESSERACT_CMD=

# ---------------------------------------------------------------------------
# AI-assisted matching (OPTIONAL, off by default). Only used for genuinely ambiguous pairs that
# would otherwise go to manual review - never for clear matches or clear non-matches, and never
# sent more than the two names / cities / addresses being compared.
# ---------------------------------------------------------------------------
AI_ENABLED=false
LLM_PROVIDER=ollama                 # ollama (local, private) | openai | gemini
AI_MAX_CALLS_PER_RUN=500
# Auto-accept a high-confidence AI verdict instead of always sending it to manual review.
# Even then, the resolver still requires corroborating evidence - read entity_resolution.py.
AI_AUTO_ACCEPT=false

# Local model via Ollama (nothing leaves this machine): https://ollama.com
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Cloud providers (keys are read from here only - never logged, never returned by the API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# Processing defaults (also editable per-run in the dashboard's Settings page)
# ---------------------------------------------------------------------------
ENTITY_TYPE=hospital                # hospital | company | person | generic
BATCH_SIZE=5000
EXCEL_STREAM_THRESHOLD_MB=25

# ---------------------------------------------------------------------------
# Dashboard / API
# ---------------------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
# Optional shared-secret token. If set, every /api/* request must send it as header `X-Token`
# (the dashboard asks for it once and remembers it for the browser session). Leave blank on a
# machine only you can reach; set it before exposing the dashboard on a network.
DASHBOARD_TOKEN=
