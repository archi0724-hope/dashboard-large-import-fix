# Copy these values into Streamlit Cloud Secrets or .streamlit/secrets.toml.
# Never commit the real secrets file.
APP_PASSWORD = "replace-with-a-long-random-password"
# A different password for sales-only catalog search and comparison downloads.
# SALES_PASSWORD = "replace-with-a-different-sales-team-password"
# Use PostgreSQL for durable cloud storage. Leave unset for local SQLite storage.
# DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
